#include <stdio.h>

struct Employee
{
    int id;
    char name[50];
    float salary;
};

int main()
{
    struct Employee e[3];
    int i;

    for(i = 0; i < 3; i++)
    {
        printf("Enter Employee %d details:\n", i + 1);

        printf("ID: ");
        scanf("%d", &e[i].id);

        printf("Name: ");
        scanf("%s", e[i].name);

        printf("Salary: ");
        scanf("%f", &e[i].salary);
    }

    printf("\nEmployee Details\n");

    for(i = 0; i < 3; i++)
    {
        printf("\nEmployee %d\n", i + 1);
        printf("ID = %d\n", e[i].id);
        printf("Name = %s\n", e[i].name);
        printf("Salary = %.2f\n", e[i].salary);
    }

    return 0;
}
