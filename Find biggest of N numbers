#include <stdio.h>

int main()
{
    int n, i, a[100], biggest;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter the elements: ");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    biggest = a[0];

    for(i = 1; i < n; i++)
    {
        if(a[i] > biggest)
        {
            biggest = a[i];
        }
    }

    printf("Biggest = %d", biggest);

    return 0;
}
