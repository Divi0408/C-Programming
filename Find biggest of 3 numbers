#include <stdio.h>

int main()
{
    int a, b, c;

    printf("Enter three numbers: ");
    scanf("%d %d %d", &a, &b, &c);

    if(a >= b && a >= c)
        printf("Biggest = %d", a);
    else if(b >= a && b >= c)
        printf("Biggest = %d", b);
    else
        printf("Biggest = %d", c);

    return 0;
}
