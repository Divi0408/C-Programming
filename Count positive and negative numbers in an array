#include <stdio.h>

int main()
{
    int n, i, a[100];
    int positive = 0, negative = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter the elements: ");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    for(i = 0; i < n; i++)
    {
        if(a[i] > 0)
            positive++;
        else if(a[i] < 0)
            negative++;
    }

    printf("Positive numbers = %d\n", positive);
    printf("Negative numbers = %d", negative);

    return 0;
}
